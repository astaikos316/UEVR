         }
 
         if (s_is_chunked) {
@@ -78,18 +94,18 @@ struct FUObjectArray {
                 return nullptr;
             }
 
-            return (FUObjectItem*)((uintptr_t)chunk + (chunk_offset * s_item_distance));
+            return (FUObjectItem*)((uintptr_t)chunk + (chunk_offset * s_item_distance) + s_item_object_offset);

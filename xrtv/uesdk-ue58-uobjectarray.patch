@@ -109,5 +125,10 @@ private:
     static inline bool s_uses_different_chunk_size{false};
     static inline uint32_t s_custom_objects_per_chunk{OBJECTS_PER_CHUNK};
     static inline int32_t s_item_distance{sizeof(FUObjectItem)}; // bruteforced later for older versions
+
+    // XRTV patch: layout overrides, set only by the XRTV_GUOBJECTARRAY_* environment override in get().
+    static inline size_t s_objects_offset{OBJECTS_OFFSET};
+    static inline int32_t s_count_offset_override{-1};
